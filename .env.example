# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — strongly recommended for batches. Without it GitHub allows only 60 requests/hour.
# Create a fine-grained token with public repo read access: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MAX_CONCURRENT_REQUESTS=4
# MAX_CONCURRENT_CANDIDATES=10
# GITHUB_TIMEOUT=15
# URL_TIMEOUT=10
